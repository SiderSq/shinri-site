# Порт запуска сервера
PORT=3000

# Обязательный уникальный пароль для доступа к /admin и /admin/round
ADMIN_PASSWORD=

# Секрет сессий
SESSION_SECRET=

# Включите 'true', если сайт работает за Nginx / Cloudflare (для корректной IP-блокировки)
TRUST_PROXY=false

# Для production: путь к приватному постоянному хранилищу вне репозитория
# SHINRI_DATA_DIR=/srv/shinri-private-data
